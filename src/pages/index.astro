---
import { Code } from 'astro:components';
import Base from '../layouts/Base.astro';
import '../styles/page.css';
import CopyCmd from '../components/CopyCmd.svelte';
import Benchmarks from '../components/Benchmarks.svelte';
import Pipeline from '../components/Pipeline.svelte';

const GH = 'https://github.com/torinriley/alpaca';

const features = [
  ['Written from scratch', 'Tensor engine, GGUF parser, BPE tokenizer, Llama forward pass, sampler and every Metal kernel. No llama.cpp, MLX, Core ML, ONNX, or Python at runtime.'],
  ['Custom Metal kernels', 'Tensor-op causal prefill attention and GEMM, split-K GQA decode attention, fused single-token kernels and GPU-resident greedy decoding.'],
  ['Idiomatic Swift API', 'async model loading, AsyncSequence token streaming, cancellation, seeded sampling and isolated per-generation sessions. Swift 6 language mode.'],
  ['Zero-copy weights', 'The GGUF file is memory-mapped and wrapped as a single no-copy MTLBuffer. Resident weight memory is about the file size.'],
  ['Verified against PyTorch', 'Every op has a deterministic CPU reference tested against float64 vectors. 191/191 tokenizer strings match, 72/72 greedy tokens match.'],
  ['Hardened parsing', 'Model files are treated as untrusted: bounded lengths, overflow-checked arithmetic, and 20,000 mutation-fuzzed files without a crash.'],
];

const stats = [
  ["1.56×", "faster prefill than llama.cpp"],
  ['1.38×', 'faster Q4_0 decode'],
  ['30.8k', 'prefill tokens / sec'],
  ['190 MiB', 'peak memory, 135M model'],
];

const swiftCode = `import Alpaca

// Load a GGUF model (memory-mapped, async)
let model = try await LanguageModel.load(from: modelURL)

// Stream tokens as they're generated
let stream = model.generate(
    prompt: "Explain how transformers work.",
    configuration: .init(maxTokens: 256, temperature: 0.7, seed: 42)
)

for try await token in stream {
    print(token.text, terminator: "")
}

// tokens, tok/s, time to first token, finish reason
let summary = stream.summary`;

const cliCode = `# Fetch the validation model (SmolLM2-135M-Instruct)
Scripts/fetch_models.sh

swift build -c release

# Generate
.build/release/alpaca generate Models/gguf/SmolLM2-135M-Instruct-Q8_0.gguf \\
  --chat --prompt "Name three colors." --stats

# Benchmark and profile
.build/release/alpaca bench   Models/gguf/SmolLM2-135M-Instruct-Q8_0.gguf --backend metal
.build/release/alpaca profile Models/gguf/SmolLM2-135M-Instruct-Q8_0.gguf --tokens 2048`;

const spmCode = `// Package.swift
.package(url: "https://github.com/torinriley/alpaca.git", from: "0.2.0")

// target dependency
.product(name: "Alpaca", package: "alpaca")`;

const validation = [
  ['Primitives', '≤ 2.5e-6', 'vs float64; dequantisation bit-exact'],
  ['Tiny Llama, cached vs uncached', '≤ 1.3e-6', 'vs float64 PyTorch; cached == uncached exactly'],
  ['SmolLM2-135M logits (CPU)', '7e-5', 'Q8_0 vs Hugging Face float32'],
  ['Greedy tokens (Metal)', '72 / 72', 'identical on every format'],
  ['Tokenizer', '191 / 191', 'identical token IDs vs Hugging Face'],
];

const layers = [
  ['Alpaca', 'Public API: LanguageModel, GenerationStream'],
  ['AlpacaMetal', 'Metal context, kernels, GPU Llama model and sessions'],
  ['AlpacaModels', 'GGUF parser, weight mapping, tokenizer construction'],
  ['AlpacaTokenizers', 'Byte-level BPE'],
  ['AlpacaCore', 'Tensors, CPU reference ops, KV cache, sampler'],
];

const caps = [
  ['Architecture', 'Llama-style decoder · RMSNorm · RoPE · GQA · SwiGLU'],
  ['Weights', 'GGUF v2/v3 · F16 · Q8_0 · Q4_0 (Q4_1 expanded at load)'],
  ['Tokenizer', 'Byte-level BPE · gpt2 & smollm pre-tokenizers'],
  ['Sampling', 'Greedy · temperature · top-k · top-p · seeded RNG'],
  ['Backends', 'Metal GPU · deterministic CPU reference'],
  ['Platforms', 'macOS 14+ · iOS 17+ · Apple Silicon'],
];

---

<Base title="alpaca.swift — Native LLM inference for Apple Silicon" description="A from-scratch Swift inference engine with custom Metal kernels. No llama.cpp, MLX, Core ML, ONNX, or Python at runtime.">

  <main id="top">
    <section class="hero frame">
      <h1>Native language model inference for <em>Apple silicon.</em></h1>
      <div class="hero-foot">
        <p class="sub">A from-scratch Swift inference engine with custom Metal kernels. No llama.cpp, MLX, Core ML, ONNX, or Python at runtime.</p>
        <div class="actions">
          <a class="btn solid" href="#start">Get started</a>
          <a class="btn line arrow" href={GH} target="_blank" rel="noopener">View on GitHub</a>
        </div>
      </div>

    </section>

    <section class="intro frame">
      <div class="intro-grid">
        <div class="intro-left">
          <figure class="codecard" data-copy>
            <figcaption><span>main.swift</span><button class="copybtn" type="button">Copy</button></figcaption>
            <Code code={swiftCode} lang="swift" theme="css-variables" />
          </figure>
          <div class="install">
            <CopyCmd client:load text={spmCode.split("\n")[1]} />
          </div>
        </div>
        <dl class="figures">
          {stats.map(([v, l]) => <div><dt>{v}</dt><dd>{l}</dd></div>)}
        </dl>
      </div>
    </section>

    <section id="overview" class="sec frame">
      <header class="sec-h"><h2>Everything on-device. <em>Nothing borrowed.</em></h2></header>
    </section>
    <div class="frame"><Pipeline client:load /></div>

    <section id="performance" class="sec frame">
      <header class="sec-h"><h2>Faster than llama.cpp, <em>on the same GGUF files.</em></h2></header>
      <div class="perf">
        <div class="perf-copy">
          <p>Prefill runs 1.3–1.7× faster from 128 to 4096 tokens, and decode is up to 1.38× faster. At 1.7B parameters, prefill with <code>--prefill-cache</code> is 1.1–1.3× faster as well.</p>
          <p class="cap">SmolLM2-135M-Instruct · Apple M5 · median of 7 runs · greedy decoding</p>
          <a class="ulink" href={`${GH}/blob/main/Docs/PERFORMANCE.md`} target="_blank" rel="noopener">Performance guide</a>
          <a class="ulink" href={`${GH}/blob/main/paper/alpaca-swift.pdf`} target="_blank" rel="noopener">Technical report (PDF)</a>
        </div>
        <Benchmarks client:visible />
      </div>
    </section>

    <section id="start" class="sec frame">
      <header class="sec-h"><h2>From package to first token <em>in minutes.</em></h2></header>
      <div class="start" data-tabs>
        <div class="tabbar" role="tablist">
          <button class="on" data-t="spm">Package.swift</button>
          <button data-t="swift">Swift</button>
          <button data-t="cli">Command line</button>
        </div>
        <div class="panel codecard" data-copy><button class="copybtn float" type="button">Copy</button>
          <div data-p="spm"><Code code={spmCode} lang="swift" theme="css-variables" /></div>
          <div data-p="swift" hidden><Code code={swiftCode} lang="swift" theme="css-variables" /></div>
          <div data-p="cli" hidden><Code code={cliCode} lang="bash" theme="css-variables" /></div>
        </div>
        <p class="note">Cancel with <code>stream.cancel()</code>. Trim memory with <code>model.trimMemory()</code>. A SwiftUI reference app lives in <a href={`${GH}/tree/main/Examples/iOS/AlpacaDemo`} target="_blank" rel="noopener">Examples/iOS/AlpacaDemo</a>.</p>
      </div>
    </section>

    <section id="validation" class="sec frame">
      <header class="sec-h"><h2>Checked against the reference, <em>at every level.</em></h2></header>
      <p class="lede">Each operation has a deterministic CPU reference tested against vectors from numpy, PyTorch, <code>gguf</code>, and Hugging Face.</p>
      <table class="tbl">
        <thead><tr><th>Check</th><th>Result</th><th>Against</th></tr></thead>
        <tbody>{validation.map(([a, b, c]) => <tr class="rv"><td>{a}</td><td class="num">{b}</td><td class="mut">{c}</td></tr>)}</tbody>
      </table>
      <a class="ulink" href={`${GH}/blob/main/Docs/NUMERICAL_VALIDATION.md`} target="_blank" rel="noopener">Numerical validation details</a>
    </section>

    <section id="architecture" class="sec frame">
      <header class="sec-h"><h2>A small, <em>layered package.</em></h2></header>
      <div class="arch">
        <p class="lede">Weights are never copied: the GGUF file is memory-mapped and wrapped as one no-copy buffer. A decode step is six fused dispatches per layer, and greedy decoding runs entirely on the GPU.</p>
        <div>
          <ul class="layers">
            {layers.map(([n, d]) => <li class="rv"><code>{n}</code><span>{d}</span></li>)}
          </ul>
          <a class="ulink" href={`${GH}/blob/main/Docs/ARCHITECTURE.md`} target="_blank" rel="noopener">Architecture guide</a>
        </div>
      </div>
    </section>

    <section class="sec frame">
      <header class="sec-h"><h2>Capabilities.</h2></header>
      <dl class="caps">
        {caps.map(([k, v]) => <div class="rv"><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
    </section>

    <section class="closing frame">
      <h2>Swift-native model inference.</h2>
      <p class="sub">Star the repo, read the code, send a pull request.</p>
      <div class="actions">
        <a class="btn solid" href={GH} target="_blank" rel="noopener">Star on GitHub</a>
        <a class="btn line" href={`${GH}/blob/main/CONTRIBUTING.md`} target="_blank" rel="noopener">Contribute</a>
        <a class="btn line" href="https://swiftpackageindex.com/torinriley/alpaca" target="_blank" rel="noopener">Swift Package Index</a>
      </div>
    </section>
  </main>

  <footer>
    <div class="frame foot">
      <span class="word">alpaca<em>.swift</em></span>
      <div class="fl">
        <a href={GH} target="_blank" rel="noopener">GitHub</a>
        <a href={`${GH}/issues`} target="_blank" rel="noopener">Issues</a>
        <a href={`${GH}/discussions`} target="_blank" rel="noopener">Discussions</a>
        <a href={`${GH}/blob/main/CHANGELOG.md`} target="_blank" rel="noopener">Changelog</a>
        <a href={`${GH}/blob/main/CITATION.cff`} target="_blank" rel="noopener">Cite</a>
      </div>
      <span class="copy">© 2026 Torin Etheridge · MIT License</span>
    </div>
  </footer>

  <script>
    document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
      const btns = root.querySelectorAll<HTMLButtonElement>('[data-t]');
      btns.forEach((b) =>
        b.addEventListener('click', () => {
          btns.forEach((x) => x.classList.toggle('on', x === b));
          root.querySelectorAll<HTMLElement>('[data-p]').forEach((p) => (p.hidden = p.dataset.p !== b.dataset.t));
        })
      );
    });
    document.querySelectorAll<HTMLElement>('[data-copy]').forEach((box) => {
      const btn = box.querySelector<HTMLButtonElement>('.copybtn')!;
      btn.addEventListener('click', async () => {
        const pre = [...box.querySelectorAll('pre')].find((x) => !x.closest('[hidden]'));
        try { await navigator.clipboard.writeText(pre?.textContent ?? ''); btn.textContent = 'Copied'; setTimeout(() => (btn.textContent = 'Copy'), 1500); } catch {}
      });
    });
    const io = new IntersectionObserver((es) => es.forEach((e) => e.isIntersecting && (e.target.classList.add('in'), io.unobserve(e.target))), { threshold: 0.1 });
    document.querySelectorAll('.rv').forEach((el) => io.observe(el));
  </script>
</Base>
